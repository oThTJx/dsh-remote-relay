{
  "name": "@firefly0621/dsh-remote-relay",
  "description": "Standalone WebSocket relay for dsh remote control: device registry, pairing, session routing",
  "version": "0.1.0-rc.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oThTJx/dsh-remote-relay.git"
  },
  "type": "module",
  "bin": {
    "dsh-remote-relay": "lib/bin.js"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@firefly0621/dsh-remote-protocol": "workspace:^",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10"
  }
}
